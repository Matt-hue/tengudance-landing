{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Razor Pages creates data protection keys for antiforgery and warns that they are not
      // persisted. The site has no forms or cookies, so nothing depends on those keys.
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*"
}
